--- a/main/app_obd_dsp/signal_registry.h
+++ b/main/app_obd_dsp/signal_registry.h
@@ -62,6 +62,16 @@
 
 extern const sig_def_t sig_registry[SIG_STD_COUNT];
 
+/* Numeric IDs are independent of slot order; unknown static IDs return -1. */
+static inline int sig_registry_slot_by_id(uint16_t num_id)
+{
+    if (num_id >= 0x0001 && num_id <= 0x000C)
+        return SIG_OBD_RPM + (int)(num_id - 0x0001);
+    if (num_id >= 0x0080 && num_id <= 0x0084)
+        return SIG_SYS_OBD_LINK + (int)(num_id - 0x0080);
+    return -1;
+}
+
 #ifdef __cplusplus
 }
 #endif
