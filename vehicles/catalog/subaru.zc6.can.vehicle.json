{
  "schema": "skygauge.vehicle/1",
  "id": "subaru.zc6.can",
  "rev": 1,
  "name": "ZN/C6 CAN",
  "origin": {
    "from": "legacy 4b056c0",
    "legacy_idx": 1,
    "legacy_name": "ZN/C6 CAN"
  },
  "requires": {
    "elm": ["ATMA"]
  },
  "bus": {
    "proto": 6,
    "atst": 10,
    "gap_ms": 1
  },
  "drivetrain": {
    "fd": 4.1,
    "tire_m": 0.314,
    "gears": [3.626, 2.188, 1.541, 1.213, 1, 0.767],
    "tol": 0.15
  },
  "monitor": {
    "mode": "probe",
    "every_ms": 500,
    "window_ms": 120,
    "stale_ms": 15000
  },
  "signals": [
    {
      "id": "obd.rpm",
      "rate": "every",
      "src": [
        {
          "req": "010C",
          "len": 2,
          "expr": "(A*256+B)/4",
          "rpn": [["A", 0], ["k", 256], "*", ["A", 1], "+", ["k", 4], "/"]
        }
      ]
    },
    {
      "id": "obd.intake_temp",
      "src": [
        {
          "req": "010F",
          "len": 1,
          "expr": "A-40",
          "rpn": [["A", 0], ["k", 40], "-"]
        }
      ]
    },
    {
      "id": "obd.speed",
      "post": {
        "zero_le": 2,
        "zero_if_rpm_lt": 800
      },
      "src": [
        {
          "req": "010D",
          "len": 1,
          "expr": "A",
          "rpn": [["A", 0]]
        }
      ]
    },
    {
      "id": "obd.coolant_temp",
      "src": [
        {
          "can": "360",
          "bit": 24,
          "bits": 8,
          "expr": "X-40",
          "rpn": [["X"], ["k", 40], "-"]
        }
      ]
    },
    {
      "id": "obd.load",
      "src": [
        {
          "req": "0104",
          "len": 1,
          "expr": "A*100/255",
          "rpn": [["A", 0], ["k", 100], "*", ["k", 255], "/"]
        }
      ]
    },
    {
      "id": "obd.throttle",
      "src": [
        {
          "can": "140",
          "bit": 48,
          "bits": 8,
          "expr": "X*100/255",
          "rpn": [["X"], ["k", 100], "*", ["k", 255], "/"]
        }
      ]
    },
    {
      "id": "obd.oil_temp",
      "valid": [-20, 150],
      "src": [
        {
          "can": "360",
          "bit": 16,
          "bits": 8,
          "expr": "X-40",
          "rpn": [["X"], ["k", 40], "-"]
        }
      ]
    },
    {
      "id": "obd.battery_voltage",
      "unit": "mV",
      "src": [
        {
          "req": "0142",
          "len": 2,
          "expr": "A*256+B",
          "rpn": [["R", 0, 16, "be"]]
        }
      ]
    },
    {
      "id": "obd.afr",
      "src": [
        {
          "req": "0144",
          "len": 2,
          "valid": [8, 22],
          "expr": "(A*256+B)*14.7/32768",
          "rpn": [["R", 0, 16, "be"], ["k", 14.7], "*", ["k", 32768], "/"]
        }
      ]
    },
    {
      "id": "obd.gear",
      "derive": "ratio"
    }
  ]
}
