# ESP32-S3 OBD Gauge — Minimal sdkconfig.defaults
# Generated for ESP-IDF 5.5.3, merged from previous .esp32s3 variant.
# Only non-default settings that matter for this project.

# ---- Target & Optimization ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- Flash (16MB Waveshare board) ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Bluetooth (BLE GATT Client for ELM327 + RaceChrono GATTS) ----
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BTU_TASK_STACK_SIZE=4096
# BTC task runs ALL GAP/GATTC/GATTS app callbacks. IDF default 3072 overflows
# with WiFi/BT coexistence. Increase to 8KB.
CONFIG_BT_BTC_TASK_STACK_SIZE=8192
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
CONFIG_BTDM_CTRL_BLE_MAX_CONN=3
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=0
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=0
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y

# ---- SPIRAM (8MB octal PSRAM @ 80MHz) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# WiFi LWIP can use PSRAM when internal DRAM exhausted (SoftAP beacon buffers).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ---- WiFi (SoftAP for OTA, coexist with ESP-NOW on STA) ----
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# ---- FATFS (SD card, 32KB cluster, long filename on heap, UTF-8) ----
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=64
# Let f_read/f_write use dynamic stack buffers instead of a single global one.
# Reduces static BSS and lets multiple tasks do concurrent I/O.

# ---- LVGL (v8.4.0, 16-bit color, DMA-safe internal double-buffer for ST77916) ----
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_LOG=n
# Disable examples and demos — we only need the core library.
CONFIG_LV_BUILD_EXAMPLES=n

# ---- HTTP Server (OTA endpoints + device web UI) ----
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# ---- ESP-NOW (multi-gauge master/slave link on channel 1) ----
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0

# ---- LittleFS (config partition, 1MB) ----
# Uses joltwallet/littlefs component from idf_component.yml.

# ---- OTA & Coredump ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n

# ---- Logging (reduce UART busy-wait, especially after removing RS485 brake temp) ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

# ---- mbedTLS (SHA-256 for OTA integrity, base64 for token) ----
CONFIG_MBEDTLS_HARDWARE_SHA=y

# ---- Newlib (nano formatting saves ~40KB, but loses %ll support — keep standard) ----
CONFIG_NEWLIB_NANO_FORMAT=n

# ---- PSRAM workarounds ----
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# ---- Component-specific (button/knob removed per REFACTOR_PLAN P0) ----
# No longer needed: CONFIG_BUTTON_... and CONFIG_KNOB_... dependencies removed.
