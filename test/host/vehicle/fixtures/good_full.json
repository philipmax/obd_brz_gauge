{
  "schema": "skygauge.vehicle/1",
  "id": "test.full",
  "rev": 3,
  "name": "Test Full",
  "origin": {"note": "host unit-test fixture, exercises every schema feature"},
  "requires": {"elm": ["ATMA", "ATCEA"]},
  "bus": {"proto": 6, "hdr": "7E0", "atst": 10, "gap_ms": 1, "init": ["ATCAF1", "at sp 6"]},
  "drivetrain": {"fd": 4.1, "tire_m": 0.314, "gears": [3.626, 2.188, 1.541, 1.213, 1.0, 0.767], "tol": 0.15},
  "monitor": {"mode": "probe", "every_ms": 500, "window_ms": 120, "stale_ms": 15000},
  "luts": [[[0, 0], [1, 6, 1], [7, -1]]],
  "signals": [
    {"id": "obd.rpm", "rate": "every",
     "src": [{"req": "010C", "len": 2, "expr": "(A*256+B)/4", "rpn": [["A",0],["k",256],"*",["A",1],"+",["k",4],"/"]}]},
    {"id": "obd.speed", "post": {"zero_le": 2, "zero_if_rpm_lt": 800},
     "src": [{"req": "010D", "len": 1, "rpn": [["A",0]]}]},
    {"id": "obd.coolant_temp",
     "src": [{"can": "360", "bit": 24, "bits": 8, "rpn": [["X"],["k",40],"-"]},
             {"req": "0105", "len": 1, "rpn": [["A",0],["k",40],"-"]}]},
    {"id": "obd.oil_temp", "valid": [-20, 150], "filter": "temp_hyst",
     "src": [{"can": "360", "bit": 16, "bits": 8, "rpn": [["X"],["k",40],"-"]},
             {"req": "2101", "multiframe": true, "byte_from_end": 5, "valid": [-10, 150],
              "hold": {"delta": 8, "max_hold": 30, "gap_ms": 3000}, "rpn": [["X"],["k",40],"-"]}]},
    {"id": "obd.intake_temp",
     "src": [{"req": "010F", "len": 1, "rpn": [["A",0],["k",40],"-"]}]},
    {"id": "obd.oil_pressure", "post": {"clamp": [0, 20]},
     "src": [{"req": "224436", "hdr": "7E0", "len": 2, "rpn": [["R",0,16,"be"],["k",1000],"/"]}]},
    {"id": "obd.gear", "fallback": "ratio",
     "src": [{"raw": "18 03 22 DA 2E", "hdr": "6F1", "rx": "618", "expect": "62DA2E", "len": 1,
              "valid": [0, 8], "rpn": [["A",0],["lut",0]]}]},
    {"id": "veh.trans_temp", "name": "Trans temp", "unit": "C", "rate": "slow", "div": 8,
     "src": [{"req": "221310", "hdr": "7E1", "cea": "10", "len": 2,
              "rpn": [["A",0],["k",256],"*",["A",1],"+",["k",100],"/",["k",40],"-"]}]},
    {"id": "veh.coolant_raw", "rate": "on_demand", "period_ms": 500,
     "src": [{"req": "0105", "len": 1, "rpn": [["A",0]]}]},
    {"id": "veh.mil_bits",
     "src": [{"req": "0101", "len": 4, "rpn": [["A",0],["k",127],"&"]}]}
  ]
}
