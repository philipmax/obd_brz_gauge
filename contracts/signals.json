{
  "format": "skygauge.signals/1",
  "registry_version": 1,
  "editor_compat": {
    "repo": "obd_theme_store",
    "branch": "codex/local-frontend",
    "commit": "5a7484e",
    "sources": [
      "frontend/src/lib/gaugeModel.ts:17-64 (DATA_SOURCES, DATA_SOURCE_LABELS, DATA_SOURCE_DIVISORS, DATA_SOURCE_FORMATS)",
      "frontend/src/lib/themeContract.ts:29-53 (DataSourceSpec, DATA_SOURCE_SPECS)"
    ],
    "note": "The 11 editor keys, their order and their delivery encodings are frozen by the editor. 'editor' blocks below are verbatim copies; tools/fixtures_node/run_ts_crosscheck.mjs compares them with the pinned editor checkout."
  },
  "conventions": {
    "id": "16-bit numeric id, written as a 4-digit upper-case hex string. Ids are runtime-only; themes, rules and profiles always reference signals by 'key'.",
    "internal": "Runtime value is int32 fixed point: internal = R(engineering_value * internal.scale), R(v) = floor(v + 0.5) evaluated in double. internal.min/max is the plausibility range in internal units; a sample outside it is stored as invalid (replaces the legacy sentinel values).",
    "valid": "Every signal carries a valid bit and a last-update timestamp. A value is valid only if the bit is set and now - ts < stale_ms (stale_ms 0 = never stale; obd.* values are initial and get tuned in P3). When sys.obd_link < 2 every obd.* signal is invalid.",
    "delivery": "Value handed to theme bindings and rules. Conversion from internal: op 'identity' (d = v), 'mul' (d = ROUND(v * by)), 'div' (d = ROUND(v / by)); ROUND is 'half_up' = R(), 'floor' = floor(), 'exact' (result is always integral). Rules receive the delivered value as double; an invalid signal is delivered to rules as NaN (relational ops and == false, != true), bindings show the invalid state.",
    "profile_units": "Units a vehicle profile may declare for the RPN result of a standard signal, mapped to the factor that converts that unit into the internal unit (internal = R(rpn_result * factor)). profile_unit_default applies when the profile signal has no 'unit'.",
    "legacy": "Mappings to the pre-refactor parallel definitions. cache = obd_data_snapshot_t (main/app_obd_dsp/obd_data_cache.h:31-46); theme_snapshot = obd_snapshot_t (main/theme_engine/theme_interface.h:27-40); disp_item = disp_item_t (main/export_path/ui_disp_item.h:22-35); racechrono = virtual CAN id (main/bsp_obd_dsp/racechrono_ble_diy.c:81-89); espnow_v5 = espnow_obd_packet_t field (main/bsp_obd_dsp/espnow_link.c:86-105). 'to_internal' converts the legacy value into the internal unit, 'from_internal' converts back."
  },
  "ranges": [
    {"prefix": "obd.", "first": "0x0001", "last": "0x007F", "allocation": "static", "description": "Standard engine/vehicle signals. Keys of the 11 editor data sources never change."},
    {"prefix": "sys.", "first": "0x0080", "last": "0x00BF", "allocation": "static", "description": "Read-only device state (link, role, page, ...)."},
    {"prefix": "cfg.", "first": "0x00C0", "last": "0x00FF", "allocation": "reserved", "description": "Reserved for user-configured thresholds read from NVS (e.g. cfg.rpm_warn). No entries in registry v1."},
    {"prefix": "veh.", "first": "0x0100", "last": "0x011F", "allocation": "dynamic", "max_entries": 32, "key_pattern": "^veh\\.[a-z0-9_]{1,24}$", "description": "Vehicle-profile custom signals. Ids are assigned at profile load time in profile declaration order; unit/decimals/range come from the profile. No entries in the registry."},
    {"prefix": "ext.", "first": "0x0200", "last": "0x02FF", "allocation": "reserved", "description": "External sensors added later (e.g. ext.tpms.* from the stashed TPMS BLE client). Existing ADS1115 oil pressure stays on obd.oil_pressure. No entries in registry v1."},
    {"prefix": "flag.", "first": "0x0400", "last": "0x040F", "allocation": "reserved", "description": "Reserved for rule cascades (rules v2.1). No entries in registry v1."}
  ],
  "retired": [
    {
      "former_key": "obd.brake_temp",
      "reason": "Brake temperature (RS485) is removed from the firmware; the key is never assigned.",
      "legacy": {
        "cache": {"field": "brake_temp_x10", "unit": "0.1 C", "invalid": -1000},
        "disp_item": {"name": "DISP_ITEM_BKT", "index": 9, "note": "index stays reserved; NVS fields storing disp_item indices must not be renumbered"},
        "racechrono": {"id": "0xF109", "note": "never reuse this id"},
        "espnow_v5": {"field": "brake_temp_x10", "ctype": "int16_t", "note": "field stays in the v5 struct; a master must send -1000 (invalid) for the v5 compatibility period"}
      }
    }
  ],
  "allocation_policy": {
    "racechrono_next_id": "0xF10A",
    "racechrono_note": "F101-F108 keep their meaning; F109 is retired; new signals are allocated from F10A upward (REFACTOR_PLAN.md P3).",
    "espnow": "v6 (TLV) carries signals by numeric id; v5 field mapping is listed per signal for the transition period."
